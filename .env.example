# ── Database ──────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=pooly
DB_PASSWORD=change_me_please
DB_NAME=pooly

# ── Application ───────────────────────────────────
APP_PORT=8080
TZ=America/New_York

# Optional PIN for app access (leave empty to disable)
APP_PIN=

# ── Home Assistant ────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# Set HA_PUSH_MODE=true when using the Pooly HACS integration.
# HA will push sensor data to Pooly via POST /api/ha/sensor so Pooly
# does not need to poll HA. HA_URL + HA_TOKEN are still used for
# outbound notifications even in push mode.
HA_PUSH_MODE=true

# Only needed when HA_PUSH_MODE=false (Pooly polls HA directly)
HA_TEMP_ENTITY=sensor.pool_temperature
HA_PUMP_ENTITY=switch.pool_pump
HA_PUMP_ENERGY_ENTITY=sensor.pool_pump_energy

# Days of sensor history to retain (older readings pruned nightly at 3am)
SENSOR_RETENTION_DAYS=30

# ── Weather (OpenWeatherMap free tier) ────────────
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_LAT=35.0
WEATHER_LON=-80.0
